{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "outDir": "./dist",            // Keeps compiled code separate
    "rootDir": "./",             // looks at root folder
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,      // Allows importing .json files if needed
    "types": ["node", "express", "jsonwebtoken", "bcryptjs", "cookie-parser"]
  },
  "include": ["**/*.ts"],       // Include all TS files in the project
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}